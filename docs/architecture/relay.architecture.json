  "cards": [
    {
      "dot": "emerald",
      "title": "One task, end to end",
      "items": [
        "The orchestrator writes .relay/tasks/NNN-slug.md; autopilot drains the queue unattended",
        "Each agent owns one channel on the file bus: results/, evidence/, mutation/, reports/",
        "On FAIL the validator writes the follow-up task itself; repeated FAILs stop the run"
      ]
    },
    {
      "dot": "amber",
      "title": "Free panes, one paid seat",
      "items": [
        "Executor, scout and mutator run on agy and fall back to opencode's free model when agy's quota runs out",
        "Only the validator spends Claude quota, and it clears its context before every grade"
      ]
    },
    {
      "dot": "violet",
      "title": "Recent changes (PRs #12–#14)",
      "items": [
        "#12: restarts re-read the state file, so a manual --provider switch survives a running autopilot",
        "#13: relay.sh steps the cursor to Yes on Claude Code's folder-trust prompt instead of pressing Enter blind",
        "#14: REA reverse-engineering evidence, opt-in with RELAY_REA=1, via the rea CLI"
      ]
    }
  ]
